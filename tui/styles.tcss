/* otoium TUI スタイル */

Screen {
    background: $surface;
}

Header {
    background: $primary-darken-2;
}

#wizard-body {
    height: 1fr;
    padding: 1 2;
    overflow-y: auto;
}

#step-label {
    text-style: bold;
    color: $accent;
    margin-bottom: 1;
}

Rule {
    margin: 1 0;
    color: $primary-darken-1;
}

.field-label {
    color: $text-muted;
    margin-top: 1;
}

.option-label {
    color: $text;
    width: 1fr;
    content-align: left middle;
}

Input {
    margin-bottom: 1;
}

RadioSet {
    height: auto;
    margin-bottom: 1;
}

RadioButton {
    padding: 0 1;
}

#options-row {
    height: auto;
    margin: 1 0;
    align: left middle;
}

Switch {
    margin-left: 2;
}

#nav-buttons {
    height: auto;
    margin-top: 2;
}

#nav-buttons Button {
    margin-right: 2;
}

/* Step 3 */
#progress-label {
    color: $text-muted;
    margin-bottom: 1;
}

ProgressBar {
    width: 1fr;
    margin-bottom: 1;
}

/* Step 4 */
#result-header {
    height: auto;
    align: left middle;
    margin-bottom: 1;
}

#result-header Button {
    margin-right: 1;
}

#result-summary {
    width: 1fr;
    content-align: left middle;
}

ResultTable {
    height: 1fr;
    min-height: 8;
}

LogPane {
    height: 7;
    border: solid $primary-darken-1;
}

/* Step 1 wav preview */
#wav-preview {
    height: 1fr;
    min-height: 6;
    border: solid $primary-darken-1;
}

#preview-label {
    margin: 1 0;
}

DataTable {
    height: 1fr;
}
